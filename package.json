{
  "name": "serverstore",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted multi-store data service: one core, many named stores, access-key permissions.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gate": "bash scripts/gate.sh",
    "serve": "node --experimental-strip-types src/server/main.ts",
    "admin:key": "node --experimental-strip-types src/admin/mint-key.ts"
  },
  "devDependencies": {
    "@hono/node-server": "^1.19.17",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "hono": "^4.13.9"
  }
}
